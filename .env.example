# Ortam değişkenleri örneği. Bu dosyayı `.env` olarak kopyalayın (git'e girmez) veya
# değişkenleri kabuğunuzda export edin. Üretimde JWT_SECRET ZORUNLUDUR (yoksa servis açılmaz).

# --- Kimlik / kripto ---------------------------------------------------------
# JWT imzalama sırrı. Güçlü rastgele bir değer üretin, örn:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Üretim modunu işaretler. production iken JWT_SECRET set değilse servis gürültülü hata verir.
# NODE_ENV=production

# --- Veritabanı (PostgreSQL + PostGIS, ADR-009) ------------------------------
# Ya DATABASE_URL'i tek parça verin...
# DATABASE_URL=postgres://mufettis:mufettis-dev@127.0.0.1:5432/mufettis

# ...ya da parça parça (docker-compose.yml de bu değişkenleri okur).
# Verilmezse aşağıdaki varsayılanlar kullanılır (yerel geliştirme).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=mufettis
PGUSER=mufettis
PGPASSWORD=mufettis-dev

# Bağlantı havuzu üst sınırı (varsayılan 10).
# PG_POOL_MAX=10

# --- Dış servisler -----------------------------------------------------------
# OpenWeatherMap. Verilmezse /api/weather deterministik bir demo yanıtına düşer.
# OPENWEATHER_API_KEY=a4662d510b59c4282322044920c0d601

# İBB Açık Veri portalı abonelik anahtarı (ADR-008). Bazı api.ibb.gov.tr uçları
# Ocp-Apim-Subscription-Key ister; anahtarsız erişilebilenler için boş bırakılabilir.
# IBB_API_KEY=
